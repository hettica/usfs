        User_Actions=   {4,1,"Inspect usfsctl and restart the affected daemon and mount"}
        Detail_Data=    4,{5,1,"USFS fault code"},DEC
        Detail_Data=    4,{5,2,"Error number"},DEC
        Detail_Data=    4,{5,3,"Daemon channel"},DEC
        Detail_Data=    4,{5,4,"Protocol opcode"},HEX
        Detail_Data=    8,{5,5,"Request unique identifier"},LDEC
        Detail_Data=    4,{5,6,"Affected mount count"},DEC

